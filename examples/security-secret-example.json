{
  "id": "secret/prod/stripe/api-key",
  "name": "stripe-api-key-prod",
  "description": "Stripe live secret key used by the billing service to charge customers.",
  "type": "api_key",
  "backend": "hashicorp-vault",
  "path": "secret/data/prod/stripe",
  "environment": "prod",
  "owner": "billing-team@example.com",
  "rotation": {
    "enabled": true,
    "interval_days": 30,
    "last_rotated_at": "2026-05-01T03:00:00Z",
    "next_rotation_at": "2026-05-31T03:00:00Z"
  },
  "expires_at": "2027-05-01T00:00:00Z",
  "allowed_consumers": [
    "spiffe://example.com/ns/prod/sa/billing-api",
    "arn:aws:iam::123456789012:role/billing-api-prod"
  ],
  "tags": ["pci", "billing", "third-party"],
  "status": "active"
}
