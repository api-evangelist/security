{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/security/refs/heads/main/json-schema/security-secret-schema.json",
  "title": "Secret",
  "description": "Represents a managed secret (API key, database credential, certificate, signing key) stored in a secrets management platform such as HashiCorp Vault, AWS Secrets Manager, Azure Key Vault, or 1Password.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier of the secret in the secrets backend.",
      "example": "secret/prod/stripe/api-key"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name of the secret.",
      "example": "stripe-api-key-prod"
    },
    "description": {
      "type": "string",
      "description": "What this secret is used for.",
      "example": "Stripe live secret key used by the billing service to charge customers."
    },
    "type": {
      "type": "string",
      "enum": [
        "api_key",
        "bearer_token",
        "oauth_client_secret",
        "database_credential",
        "tls_certificate",
        "ssh_key",
        "signing_key",
        "encryption_key",
        "generic"
      ],
      "description": "Category of secret material.",
      "example": "api_key"
    },
    "backend": {
      "type": "string",
      "enum": [
        "hashicorp-vault",
        "aws-secrets-manager",
        "aws-kms",
        "azure-key-vault",
        "google-secret-manager",
        "1password",
        "cyberark",
        "doppler",
        "kubernetes-secret",
        "other"
      ],
      "description": "Secrets backend that stores this secret.",
      "example": "hashicorp-vault"
    },
    "path": {
      "type": "string",
      "description": "Logical path or identifier inside the backend.",
      "example": "secret/data/prod/stripe"
    },
    "environment": {
      "type": "string",
      "enum": ["dev", "test", "staging", "prod"],
      "description": "Deployment environment this secret applies to.",
      "example": "prod"
    },
    "owner": {
      "type": "string",
      "description": "Team or service account that owns this secret.",
      "example": "billing-team@example.com"
    },
    "rotation": {
      "type": "object",
      "description": "Rotation policy and state for the secret.",
      "properties": {
        "enabled": { "type": "boolean", "example": true },
        "interval_days": { "type": "integer", "minimum": 1, "example": 30 },
        "last_rotated_at": { "type": "string", "format": "date-time", "example": "2026-05-01T03:00:00Z" },
        "next_rotation_at": { "type": "string", "format": "date-time", "example": "2026-05-31T03:00:00Z" }
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this secret expires and must no longer be used. Null for non-expiring secrets.",
      "example": "2027-05-01T00:00:00Z"
    },
    "allowed_consumers": {
      "type": "array",
      "description": "Service identities or workload IDs (e.g., SPIFFE IDs, IAM role ARNs) allowed to read this secret.",
      "items": { "type": "string" },
      "example": [
        "spiffe://example.com/ns/prod/sa/billing-api",
        "arn:aws:iam::123456789012:role/billing-api-prod"
      ]
    },
    "tags": {
      "type": "array",
      "description": "Tags for cataloging and policy enforcement.",
      "items": { "type": "string" },
      "example": ["pci", "billing", "third-party"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "pending_rotation", "revoked", "expired"],
      "description": "Operational status of the secret.",
      "example": "active"
    }
  },
  "required": ["id", "name", "type", "backend"]
}
